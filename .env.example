# ==========================================
# Cinema System - Root Environment Template
# Copy this file to .env and edit values here only.
# ==========================================

# Shared JWT configuration
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long!
JWT_ISSUER=CinemaSystem.Identity
JWT_AUDIENCE=CinemaSystem.Clients

# Docker / infrastructure
SA_PASSWORD=YourStrong@Passw0rd
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Frontend
VITE_API_GATEWAY_URL=http://localhost:5200
VITE_PAYMENT_API_URL=http://localhost:5200
FRONTEND_BASE_URL=http://localhost:5173

# Internal Docker service URLs
IDENTITY_API_URL=http://identity-api:8080
CINEMA_API_URL=http://cinema-api:8080
MOVIE_API_URL=http://movie-api:8080
BOOKING_API_URL=http://booking-api:8080
PAYMENT_API_URL=http://payment-api:8080
NOTIFICATION_API_URL=http://notification-api:8080

# Payment.API / SePay
SEPAY_MERCHANT_ID=your-sepay-merchant-id
SEPAY_SECRET_KEY=your-sepay-secret-key
SEPAY_ENVIRONMENT=sandbox
SEPAY_IPN_URL=https://your-ngrok-url.ngrok-free.dev/api/payments/sepay/ipn
PAYMENT_PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.dev
FRONTEND_BASE_URL=http://localhost:5173

# Optional ngrok container for SePay IPN testing
NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-ngrok-domain.ngrok-free.dev
NGROK_WEB_PORT=4040

# Notification.API / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@cinema-system.com
SMTP_FROM_NAME=Cinema System

# Movie.API / Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
